# ==============================================================================
# Skippy - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sensitive Credentials & API Keys (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml
.streamlit/credentials.toml
*.pem
*.key

# ------------------------------------------------------------------------------
# 2. Personal Data & User Documents (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
# User's master resume, multi-resume vault, and generated documents
resume.md
resumes.json
profile_alignment.json
custom_prompt.txt
custom_user_prompt.txt
app_settings.json
*.docx
*.pdf

# Persistent database, journals, and WAL files
skippy.db
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.sqlite

# Incoming job queue
inbox.json

# ------------------------------------------------------------------------------
# 3. Virtual Environments & Local Runtimes
# ------------------------------------------------------------------------------
venv/
test_venv/
env/
ENV/
.venv/
python_runtime/
python_portable.zip

# ------------------------------------------------------------------------------
# 4. Bytecode, Build Artifacts & Test Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
scratch/

# ------------------------------------------------------------------------------
# 5. Distribution Packages, Archives & Unzipped Extension
# ------------------------------------------------------------------------------
releases/
*.zip
*.tar.gz
# Ignore unzipped extension source directory/files and external portfolio directory
skippy-extension/
portfolio-site/
portfoliosite/
# Explicitly track the extension installer required by the application
!skippy_extension.zip

# ------------------------------------------------------------------------------
# 6. Temporary Files, Backups & Logs
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
