# ==============================================================================
# Skippy AI Job CRM - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Enter your API key below.
# 3. Restrict permissions to protect your key:
#      chmod 600 .env
#
# Supported providers: Google Gemini, OpenAI, Anthropic, xAI Grok.
# (If using local Ollama, an API key is not required).
# ==============================================================================

USER_API_KEY=""

# Optional background webhook server configuration (defaults to 127.0.0.1:8000)
# SKIPPY_WEBHOOK_HOST="127.0.0.1"
# SKIPPY_WEBHOOK_PORT="8000"

# Optional Authentication Configuration
# (If omitted, Skippy prompts you to create an admin account on first launch and saves a salted PBKDF2-SHA256 hash)
# SKIPPY_AUTH_USERNAME="admin"
# SKIPPY_AUTH_PASSWORD=""
# SKIPPY_AUTH_PASSWORD_HASH=""
# SKIPPY_MAX_LOGIN_ATTEMPTS="5"
# SKIPPY_LOCKOUT_MINUTES="15"
# SKIPPY_SESSION_TIMEOUT_MINUTES="720"
